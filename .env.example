# ============================================
# Copia este archivo como ".env" y completa los valores.
# NO subas el .env real a git (ya esta en .gitignore).
# ============================================

# Panel de administracion (/login.html)
ADMIN_USER=
ADMIN_PASS=

# Khipu (pagos con tarjeta/transferencia)
# los sacas de https://khipu.cl -> Integraciones -> API
KHIPU_API_KEY=
KHIPU_SECRET=
KHIPU_RECEIVER_ID=
# monto del anticipo en CLP
ANTICIPO_MONTO=5000

# URL publica del sitio (HTTPS). Khipu RECHAZA urls locales en el webhook,
# asi que sin esto los pagos en linea NO funcionan.
# En Render: https://paginadelarosa.onrender.com
SITIO_URL=

# Opcional: base de datos Postgres. Sin esto las reservas van a reservas.json,
# que en el plan gratis de Render se pierde en cada reinicio.
# Crea una base gratis en https://neon.tech y pega la URL "pooled"
# DATABASE_URL=
